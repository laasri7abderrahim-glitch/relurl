# === PLATFORM API KEYS ===
# Uncomment and fill in the ones you want to use.
# Get keys at the URLs listed below.

# Dev.to → https://dev.to/settings/extensions
# DEVTO_API_KEY=your_key_here

# Hashnode → https://hashnode.com/settings/developer
# HASHNODE_TOKEN=your_pat_here
# HASHNODE_PUBLICATION=your_pub_id_here

# Medium → https://medium.com/me/settings/security
# MEDIUM_TOKEN=your_integration_token_here

# WordPress → Users > Application Passwords
# WORDPRESS_URL=https://yoursite.com
# WORDPRESS_USER=your_admin_user
# WORDPRESS_APP_PASS=your_app_password

# Ghost → Admin > Integrations > Custom
# GHOST_URL=https://yourblog.ghost.io
# GHOST_ADMIN_KEY=key_id:key_secret

# Blogger → Use OAuth 2.0 token (API key alone only works for reads)
# Get OAuth token: https://developers.google.com/oauthplayground (Blogger API v3 scope)
# BLOGGER_API_KEY=your_oauth_bearer_token_here
# BLOGGER_BLOG_ID=your_blog_id_here

# LinkedIn → https://linkedin.com/developers/apps
# LINKEDIN_TOKEN=your_oauth_token

# Bluesky → https://bsky.app/settings/app-passwords
# BLUESKY_AUTH=handle.bsky.social:app-password

# Mastodon → Settings > Applications
# MASTODON_AUTH=instance.social:access_token

# Telegram → https://t.me/botfather
# TELEGRAM_AUTH=bot_token:chat_id

# Discord → Channel Settings > Integrations > Webhooks
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Write.as → https://write.as/settings (optional — anonymous posts work without token)
# WRITEAS_TOKEN=your_token_here

# Bear Blog → Bear Blog Dashboard > API
# BEARBLOG_KEY=your_api_key_here

# GitHub → https://github.com/settings/tokens (need gist scope)
# GITHUB_TOKEN=your_pat_here
# GITHUB_GIST_USER=your_username

# WriteFreely → your instance settings
# WRITEFREELY_INSTANCE=https://your-instance.com
# WRITEFREELY_TOKEN=your_token_here

# Forem (other instances like community.codenewbie.org) → instance settings
# FOREM_URL=https://community.codenewbie.org
# FOREM_API_KEY=your_api_key_here

# ReadMe → https://dash.readme.com/api/v1 > API Keys
# README_API_KEY=your_api_key_here
# README_PROJECT=your-project-slug

# GitBook → https://app.gitbook.com/account/tokens
# GITBOOK_TOKEN=your_token_here
# GITBOOK_SPACE=your_space_id_here

# LiveJournal → use your LJ account credentials (XML-RPC)
# LIVEJOURNAL_USERNAME=your_lj_username
# LIVEJOURNAL_PASSWORD=your_lj_password

# Set DRY_RUN=true to test without publishing
# DRY_RUN=true
